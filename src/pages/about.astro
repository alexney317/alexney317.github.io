---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About Alex Ney — Operating Partner, Advisor, CPA.">
  <div class="page-hero">
    <p class="page-hero__label">About</p>
    <h1 class="page-hero__title">Alex Ney</h1>
    <p class="page-hero__description">Operating Partner & Advisor · CPA · Miami, FL</p>
  </div>

  <div class="about-body">
    <p>
      Based in Miami, FL, Alex is an operator currently leading strategy, operations, and
      value creation at a family office while running a boutique advisory practice serving
      founders, business owners, and PE-backed firms.
      His career spans 100+ M&A transactions, enterprise finance transformations, and ERP
      implementations across middle-market companies in healthcare, technology, and professional
      services. He holds a B.S. in Finance & Accounting from Indiana University and is a
      licensed CPA.
    </p>
  </div>
</BaseLayout>

<style>
  .about-body {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-body p {
    margin: 0;
    font-size: var(--font-size-base);
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  .about-body strong {
    color: var(--color-text);
    font-weight: 600;
  }
</style>
