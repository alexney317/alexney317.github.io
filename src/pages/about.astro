---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About" description="About Alex Ney — Operating Partner, Advisor, CPA.">
  <div class="page-hero">
    <p class="page-hero__label">About</p>
    <h1 class="page-hero__title">Alex Ney</h1>
    <p class="page-hero__description">Operating Partner & Advisor · Miami, FL</p>
  </div>

  <div class="about-body">
    <p>
      Based in Miami, FL, Alex is an operator currently leading strategy, operations, and value creation at a family office.
    </p>

    <p></p>

    <p>
      Learning how to ship with Claude and how to integrate agents and tools into every day operational and financial processes.
    </p>
  </div>
</BaseLayout>

<style>
  .about-body {
    max-width: 680px;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .about-body p {
    margin: 0;
    font-size: var(--font-size-base);
    line-height: 1.8;
    color: var(--color-text-muted);
  }

  .about-body strong {
    color: var(--color-text);
    font-weight: 600;
  }
</style>
