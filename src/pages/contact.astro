---
import BaseLayout from '../layouts/BaseLayout.astro';
import { resume } from '../data/resume';
---

<BaseLayout title="Contact" description="Get in touch with Alex Ney.">
  <div class="page-hero">
    <p class="page-hero__label">Contact</p>
    <h1 class="page-hero__title">Get in Touch</h1>
    <p class="page-hero__description">I'd love to hear from you.</p>
  </div>

  <div class="coming-soon">
    <span class="coming-soon__icon">📬</span>
    <p class="coming-soon__text">Reach out</p>
    <p>
      Email me at{' '}
      <a href={`mailto:${resume.contact.email}`}>{resume.contact.email}</a>
    </p>
  </div>
</BaseLayout>
