---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects" description="Work and projects by Alex Ney.">
  <div class="page-hero">
    <p class="page-hero__label">Projects</p>
    <h1 class="page-hero__title">Work & Projects</h1>
    <p class="page-hero__description">Things I've built and worked on.</p>
  </div>

  <p class="projects-statement">
    Multiple projects running that are in development. Most excited about my personal operating
    and strategy management web app.<br />More to come!
  </p>

  <div class="coming-soon">
    <span class="coming-soon__icon">🚀</span>
    <p class="coming-soon__text">Coming soon</p>
    <p>Portfolio items are being prepared.</p>
  </div>
</BaseLayout>

<style>
  .projects-statement {
    font-size: var(--font-size-lg);
    color: var(--color-text-muted);
    max-width: 600px;
    line-height: 1.8;
  }
</style>
