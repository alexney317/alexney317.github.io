---
// Private admin page — not linked in nav, not indexed by search engines.
// Protected by your GitHub Personal Access Token (stored in localStorage).
// To use: create a fine-grained PAT at github.com/settings/personal-access-tokens
// with "Contents: Read & Write" permission on this repo.
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Feed Admin</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

      :root {
        --bg:      #0d1117;
        --surface: #161b22;
        --border:  #30363d;
        --text:    #e6edf3;
        --muted:   #8b949e;
        --accent:  #58a6ff;
        --green:   #3fb950;
        --red:     #f85149;
        --radius:  8px;
        --font:    'Inter', system-ui, sans-serif;
      }

      body {
        font-family: var(--font);
        background: var(--bg);
        color: var(--text);
        min-height: 100vh;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 2rem 1rem 4rem;
      }

      .card {
        width: 100%;
        max-width: 480px;
        background: var(--surface);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.75rem;
      }

      .card__title {
        font-size: 1.125rem;
        font-weight: 600;
        margin-bottom: 0.25rem;
      }

      .card__sub {
        font-size: 0.8125rem;
        color: var(--muted);
        margin-bottom: 1.5rem;
        line-height: 1.5;
      }

      .field { margin-bottom: 1rem; }

      label {
        display: block;
        font-size: 0.8125rem;
        font-weight: 500;
        color: var(--muted);
        margin-bottom: 0.375rem;
      }

      input, textarea {
        width: 100%;
        background: var(--bg);
        border: 1px solid var(--border);
        border-radius: 6px;
        color: var(--text);
        font-family: var(--font);
        font-size: 0.9375rem;
        padding: 0.625rem 0.875rem;
        outline: none;
        transition: border-color 120ms ease;
        -webkit-appearance: none;
      }

      input:focus, textarea:focus {
        border-color: var(--accent);
      }

      textarea { resize: vertical; min-height: 72px; line-height: 1.5; }

      .pat-row {
        display: flex;
        gap: 0.5rem;
      }
      .pat-row input { flex: 1; font-family: monospace; font-size: 0.8125rem; }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 0.625rem 1.25rem;
        font-size: 0.9375rem;
        font-weight: 500;
        font-family: var(--font);
        border-radius: 6px;
        border: none;
        cursor: pointer;
        transition: opacity 150ms ease, transform 150ms ease;
        width: 100%;
        margin-top: 0.25rem;
      }

      .btn:active { transform: scale(0.98); }
      .btn:disabled { opacity: 0.5; cursor: not-allowed; }

      .btn-primary {
        background: linear-gradient(135deg, #388bfd, #58a6ff);
        color: #fff;
        box-shadow: 0 0 16px rgba(88,166,255,0.25);
      }

      .btn-sm {
        width: auto;
        padding: 0.375rem 0.75rem;
        font-size: 0.8125rem;
      }

      .btn-ghost {
        background: transparent;
        color: var(--muted);
        border: 1px solid var(--border);
      }

      .status {
        margin-top: 1rem;
        padding: 0.625rem 0.875rem;
        border-radius: 6px;
        font-size: 0.875rem;
        display: none;
      }
      .status.visible { display: block; }
      .status--loading { background: rgba(88,166,255,0.1); color: var(--accent); border: 1px solid rgba(88,166,255,0.3); }
      .status--success { background: rgba(63,185,80,0.1);  color: var(--green); border: 1px solid rgba(63,185,80,0.3); }
      .status--error   { background: rgba(248,81,73,0.1);  color: var(--red);   border: 1px solid rgba(248,81,73,0.3); }

      .divider {
        border: none;
        border-top: 1px solid var(--border);
        margin: 1.5rem 0;
      }

      .hint {
        font-size: 0.75rem;
        color: var(--muted);
        margin-top: 0.375rem;
        line-height: 1.4;
      }

      .token-saved {
        font-size: 0.75rem;
        color: var(--green);
        margin-top: 0.375rem;
        display: none;
      }
    </style>
  </head>
  <body>
    <div class="card">
      <p class="card__title">Feed Admin</p>
      <p class="card__sub">
        Post a tweet to your feed. The site rebuilds automatically (~2 min after saving).
      </p>

      <!-- GitHub Token -->
      <div class="field">
        <label for="pat">GitHub Token</label>
        <div class="pat-row">
          <input id="pat" type="password" placeholder="github_pat_…" autocomplete="off" />
          <button class="btn btn-ghost btn-sm" id="save-pat">Save</button>
        </div>
        <p class="hint">Fine-grained PAT with <strong style="color:var(--text)">Contents: Read & Write</strong> on this repo. Stored in your browser only.</p>
        <p class="token-saved" id="token-saved">Token saved locally.</p>
      </div>

      <hr class="divider" />

      <!-- Tweet URL -->
      <div class="field">
        <label for="tweet-url">Tweet / Post URL</label>
        <input
          id="tweet-url"
          type="url"
          placeholder="https://x.com/user/status/…"
          autocomplete="off"
          inputmode="url"
        />
        <p class="hint">On X: tap Share → Copy Link, then paste here.</p>
      </div>

      <!-- Caption (optional) -->
      <div class="field">
        <label for="caption">Caption <span style="font-weight:400;opacity:0.6">(optional)</span></label>
        <textarea id="caption" placeholder="Why this is worth sharing…"></textarea>
      </div>

      <button class="btn btn-primary" id="submit">Add to Feed</button>

      <div class="status" id="status"></div>
    </div>

    <script is:inline>
      const REPO   = 'alexney317/alexney317.github.io';
      const FILE   = 'src/data/feed.json';
      const API    = `https://api.github.com/repos/${REPO}/contents/${FILE}`;

      const patInput    = document.getElementById('pat');
      const savePatBtn  = document.getElementById('save-pat');
      const tokenSaved  = document.getElementById('token-saved');
      const tweetInput  = document.getElementById('tweet-url');
      const captionInput= document.getElementById('caption');
      const submitBtn   = document.getElementById('submit');
      const statusEl    = document.getElementById('status');

      // Restore saved token
      const saved = localStorage.getItem('gh_pat');
      if (saved) {
        patInput.value = saved;
        tokenSaved.style.display = 'block';
      }

      savePatBtn.addEventListener('click', () => {
        const val = patInput.value.trim();
        if (!val) return;
        localStorage.setItem('gh_pat', val);
        tokenSaved.style.display = 'block';
      });

      submitBtn.addEventListener('click', async () => {
        const pat      = patInput.value.trim() || localStorage.getItem('gh_pat') || '';
        const tweetUrl = tweetInput.value.trim();
        const caption  = captionInput.value.trim();

        if (!pat)      { showStatus('Enter your GitHub token first.', 'error'); return; }
        if (!tweetUrl) { showStatus('Paste a tweet URL first.', 'error'); return; }

        submitBtn.disabled = true;
        showStatus('Saving to feed…', 'loading');

        try {
          await postEntry(pat, tweetUrl, caption);
          tweetInput.value = '';
          captionInput.value = '';
          showStatus('Done! Site will rebuild in ~2 minutes.', 'success');
        } catch (err) {
          showStatus(err.message, 'error');
        } finally {
          submitBtn.disabled = false;
        }
      });

      async function postEntry(pat, rawUrl, caption) {
        // Normalize x.com → twitter.com for embed compatibility
        const tweetUrl = rawUrl.replace(/^https?:\/\/x\.com/, 'https://twitter.com');

        // 1. Read current file (need SHA + content)
        const getResp = await fetch(API, {
          headers: {
            'Authorization': `Bearer ${pat}`,
            'Accept': 'application/vnd.github+json',
          },
        });

        if (getResp.status === 401) throw new Error('Invalid token — check your GitHub PAT.');
        if (!getResp.ok)           throw new Error(`Could not read feed.json (${getResp.status}).`);

        const file    = await getResp.json();
        const current = JSON.parse(atob(file.content.replace(/\s/g, '')));

        // 2. Prepend new entry
        const entry = {
          id:       Date.now().toString(),
          date:     new Date().toISOString(),
          type:     'tweet',
          tweetUrl: tweetUrl,
          caption:  caption || null,
        };

        const updated = [entry, ...current];

        // 3. Write back via GitHub API
        const body = JSON.stringify({
          message: `Add feed entry ${new Date().toLocaleDateString('en-US')}`,
          content: btoa(unescape(encodeURIComponent(JSON.stringify(updated, null, 2)))),
          sha:     file.sha,
        });

        const putResp = await fetch(API, {
          method:  'PUT',
          headers: {
            'Authorization': `Bearer ${pat}`,
            'Accept':        'application/vnd.github+json',
            'Content-Type':  'application/json',
          },
          body,
        });

        if (!putResp.ok) {
          const err = await putResp.json().catch(() => ({}));
          throw new Error(err.message || `GitHub API error (${putResp.status}).`);
        }
      }

      function showStatus(msg, type) {
        statusEl.textContent = msg;
        statusEl.className   = `status visible status--${type}`;
      }
    </script>
  </body>
</html>
